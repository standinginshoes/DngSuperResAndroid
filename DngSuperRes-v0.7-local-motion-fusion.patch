+        double[] costs = new double[MOTION_GRID_SIZE * MOTION_GRID_SIZE];
+        int index = 0;
+        for (int gy = 0; gy < MOTION_GRID_SIZE; gy++) {
+            checkCancelled();
+            float y = minY + (maxY - minY) * gy / (MOTION_GRID_SIZE - 1f);
